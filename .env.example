APP_ENV=development
# نمونه‌ی فایل .env — یک کپی از این بساز و مقادیر واقعی خودت را جایگزین کن.
# (فایل .env واقعی پروژه از قبل با مقادیر دمو پر شده تا اجرای اولیه ساده باشد.)

SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30

# DATABASE_URL=sqlite:///./data/app.db

DEFAULT_PROVIDER_BASE_URL=https://your-openai-compatible-endpoint/v1
DEFAULT_PROVIDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_ORG_NAME=System Admin
