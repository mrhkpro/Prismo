APP_ENV=development

# Optional Google OAuth (server-side only; never expose the secret to frontend JS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback path configured in Google Cloud. Example: http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Public app URL is used only when GOOGLE_REDIRECT_URI is omitted.
APP_PUBLIC_URL=http://localhost:8000
# Copy this file to .env for local development and replace placeholders.
# Never commit .env or put server secrets in frontend files.

SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30

# Deployment database profile:
# auto = use DATABASE_URL when present, otherwise local SQLite
# supabase = force PostgreSQL/Supabase
# local = force the internal SQLite database
DATABASE_MODE=auto

# For local mode: DATABASE_URL is not required.
# DATABASE_URL=sqlite:///./data/app.db

DEFAULT_PROVIDER_BASE_URL=https://your-openai-compatible-endpoint/v1
DEFAULT_PROVIDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_ORG_NAME=System Admin

# Serverless-friendly AI network settings.
AI_REQUEST_TIMEOUT_SECONDS=120
AI_CONNECT_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=900

# Optional hosted relay for the default AI provider
AI_PROXY_BASE_URL=
AI_PROXY_API_KEY=

# Optional OpenRouter default provider (keep the API key only in this server-side file).
# DEFAULT_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_PROVIDER_API_KEY=your-openrouter-api-key
